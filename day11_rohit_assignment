# Q8. Dictionary-Based Shopping Cart
# ==================================================

cart = {
    "Laptop": 50000,
    "Mouse": 500,
    "Keyboard": 1500
}

# Add product
cart["Monitor"] = 12000

# Update price
cart["Mouse"] = 600

# Remove product
cart.pop("Keyboard")

# Total cart value
total = sum(cart.values())

print("\nShopping Cart:")
print(cart)

print("Total Cart Value:", total)

