# ==================================================
# Q7. Library Membership Analysis
# ==================================================

library_A = {"Rahul", "Amit", "Priya", "Sneha"}
library_B = {"Priya", "Karan", "Amit", "Vikram"}

print("\nCommon Members:")
print(library_A.intersection(library_B))

print("All Members:")
print(library_A.union(library_B))

print("Only Library A:")
print(library_A.difference(library_B))

