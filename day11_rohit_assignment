# Q9. Set-Based Event Registration System
# ==================================================

event1 = {"Aman", "Riya", "Karan", "Neha"}
event2 = {"Neha", "Riya", "Vikas", "Rohan"}

print("\nRegistered in Both Events:")
print(event1 & event2)

print("Registered in Exactly One Event:")
print(event1 ^ event2)

print("Total Unique Attendees:")
print(len(event1 | event2))

