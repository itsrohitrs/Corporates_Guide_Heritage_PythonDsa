# Q10. Choosing the Right Data Structure
# ==================================================

# Dictionary:
# Used because student details have key-value pairs.

students = {
    101: {"Name": "Rahul", "Course": "Python"},
    102: {"Name": "Amit", "Course": "Java"},
    103: {"Name": "Priya", "Course": "C++"}
}

print("\nStudent Details:")
print(students)

# Set:
# Used because course categories should be unique.

course_categories = {
    "Programming",
    "Data Science",
    "Web Development",
    "Programming"
}

print("\nCourse Categories:")
print(course_categories)

# List:
# Used because ratings can have duplicates and order matters.

course_ratings = [4.5, 4.8, 4.2, 4.8, 5.0]

print("\nCourse Ratings:")
print(course_ratings)